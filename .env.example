# Copy this file to `.env` and fill in your local values.
# `.env` is git-ignored: never commit real credentials.

# MySQL
SEMANTIC_MYSQL_HOST=localhost
SEMANTIC_MYSQL_PORT=3306
SEMANTIC_MYSQL_DATABASE=universidad
SEMANTIC_MYSQL_USER=root
SEMANTIC_MYSQL_PASSWORD=

# PostgreSQL
SEMANTIC_POSTGRES_HOST=localhost
SEMANTIC_POSTGRES_PORT=5432
SEMANTIC_POSTGRES_DATABASE=universidad
SEMANTIC_POSTGRES_USER=postgres
SEMANTIC_POSTGRES_PASSWORD=
